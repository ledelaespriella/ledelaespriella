# ==========================================================================
# Plantilla de variables de entorno para el portafolio.
# Copiar a `.env` y completar con valores reales. NUNCA commitear .env.
# ==========================================================================

# ---------------------------------------------------------------------------
# FLASK
# ---------------------------------------------------------------------------

# Entorno de ejecución: "development" habilita DEBUG, "production" lo fuerza a False.
FLASK_ENV=development

# Clave usada para firmar cookies de sesión y tokens CSRF.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# Debe tener AL MENOS 32 bytes (64 caracteres hex). La app aborta si falta.
SECRET_KEY=

# ---------------------------------------------------------------------------
# BASE DE DATOS
# ---------------------------------------------------------------------------

# URL SQLAlchemy. Ejemplos:
#   Dev local (SQLite):  sqlite:///portfolio.db
#   Producción Render:   postgresql://user:pass@host:5432/dbname
# Si empieza con "postgres://" (formato legado de Heroku/Render), la app
# lo normaliza a "postgresql://" automáticamente.
DATABASE_URL=sqlite:///portfolio.db

# ---------------------------------------------------------------------------
# SEED DEL ADMINISTRADOR (consumido solo por init_db.py)
# ---------------------------------------------------------------------------
# Si alguna de estas falta, init_db.py aborta con error.
# Jamás se crea un admin con credenciales por defecto.
ADMIN_USER=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# SESIONES Y SEGURIDAD (valores por defecto ya son sensatos; ajustar si se desea)
# ---------------------------------------------------------------------------

# Minutos de inactividad antes de cerrar sesión (default: 60).
SESSION_LIFETIME_MINUTES=60

# Rate limit para /admin/login (default: "5 per minute").
LOGIN_RATE_LIMIT=5 per minute

# ---------------------------------------------------------------------------
# SERVIDOR (producción)
# ---------------------------------------------------------------------------

# Puerto expuesto (Render/Railway lo inyectan automáticamente).
PORT=5000
